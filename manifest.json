{
  "manifest_version": 3,
  "name": "Tip Job Posting Analyzer",
  "version": "0.1.3",
  "description": "Send the job posting you are viewing to the server for async analysis.",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "contextMenus"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background/index.js", "type": "module" },
  "action": { "default_popup": "popup/popup.html" }
}
